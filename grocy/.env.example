# Copy to .env (git-ignored) only if the defaults don't fit this machine.
#
# Defaults: Grocy's data in ./config, Rosie's data folder is this repo's
# data/, and her database is rosies_recipe_box.db.

# Use an existing Grocy's data instead of ./config - e.g. one first started
# with `docker run -v grocy_volume:/config ...` (find the folder with
# `docker volume inspect grocy_volume --format '{{.Mountpoint}}'`):
# GROCY_CONFIG_DIR=/var/lib/docker/volumes/grocy_volume/_data

# A dev copy running Rosie Dev against a separate database would use:
# ROSIE_DB_FILE=rosie_dev.db
# ROSIE_DATA_DIR=../data
